<Window x:Class="TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestApp"
        mc:Ignorable="d"
        Title="ATC Test App" Height="450" Width="800"
        Closing="DataWindow_Closing"  >
        
    <Grid>
        <Button Content="Connect" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="97" Height="63" Name="btnConnect" Click="BtnConnect_Click"/>
        <Button Content="Disconnect" HorizontalAlignment="Left" Margin="112,10,0,0" VerticalAlignment="Top" Width="97" Height="63" Name ="btnDisconnect" Click="BtnDisconnect_Click"/>
        <Button Content="Start" HorizontalAlignment="Left" Margin="214,10,0,0" VerticalAlignment="Top" Width="97" Height="63" Name="btnStart" Click="BtnStart_Click"/>
        <Button Content="Stop" HorizontalAlignment="Left" Margin="316,10,0,0" VerticalAlignment="Top" Width="97" Height="63" Name="btnStop" Click="BtnStop_Click"/>
        <Button Content="Pause" HorizontalAlignment="Left" Margin="418,10,0,0" VerticalAlignment="Top" Width="97" Height="63" Name="Pause" Click="Pause_Click"/>
        <Button Content="Resume" HorizontalAlignment="Left" Margin="520,10,0,0" VerticalAlignment="Top" Width="97" Height="63" Name ="Resume" Click="Resume_Click"/>
        <TextBox Name="Output" HorizontalAlignment="Left" Height="99" Margin="10,310,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="772" />
        <Button Content="OpenLid" HorizontalAlignment="Left" Margin="10,92,0,0" VerticalAlignment="Top" Width="97" Height="63" x:Name="btnOpenLid" Click="BtnOpenLid_Click" />
        <Button Content="CloseLid" HorizontalAlignment="Left" Margin="112,92,0,0" VerticalAlignment="Top" Width="97" Height="63" x:Name="btnCloseLid" Click="BtnCloseLid_Click" />
        <Button Content="GetInstrumentProperties" HorizontalAlignment="Left" Margin="213,92,0,0" VerticalAlignment="Top" Width="148" Height="63" x:Name="btnInstrumentProperties" Click="BtnInstrumentProperties_Click" />
        <TextBox x:Name="IpAddress" HorizontalAlignment="Left" Height="26" Margin="112,191,0,0" VerticalAlignment="Top" Width="160" Text="{ Binding Path=address, Mode=TwoWay }" />
        <Label Content="IP ADDRESS:" HorizontalAlignment="Left" Margin="10,191,0,0" VerticalAlignment="Top" Width="97"/>
        <Button Content="Get Status" HorizontalAlignment="Left" Margin="367,92,0,0" VerticalAlignment="Top" Width="148" Height="63" x:Name="btnGetStatus" Click="BtnGetStatus_Click" />
        <Button Content="Start Long Run" HorizontalAlignment="Left" Margin="520,92,0,0" VerticalAlignment="Top" Width="97" Height="63" x:Name="btnStartLongRun" Click="BtnStartLongRun_Click"/>
    </Grid>
</Window>

    