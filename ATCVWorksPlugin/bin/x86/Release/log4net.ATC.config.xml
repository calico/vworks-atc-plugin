<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <appender name="PluginFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="C:\Automation\Logs\ATC_PLUGIN_LOG.txt"/>
    <appendToFile value="true"/>
    <rollingStyle value="Size"/>
    <maximumFileSize value="10MB"/>
    <maxSizeRollBackups value="5"/>
    <staticLogFileName value="true"/>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%logger] %-5level - %message%newline%exception"/>
    </layout>
    <filter type="log4net.Filter.StringMatchFilter">
      <stringToMatch value="TemperatureEvent" />
      <acceptOnMatch value="false" />
    </filter>
  </appender>
  <appender name="TemperatureFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="C:\Automation\Logs\ATC_TEMP_LOG.txt"/>
    <appendToFile value="true"/>
    <rollingStyle value="Size"/>
    <maximumFileSize value="5MB"/>
    <maxSizeRollBackups value="5"/>
    <staticLogFileName value="true"/>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%logger] %-5level - %message%newline%exception"/>
    </layout>
    <filter type="log4net.Filter.StringMatchFilter">
      <stringToMatch value="TemperatureEvent" />
      <acceptOnMatch value="true"/>
    </filter>
    <filter type="log4net.Filter.DenyAllFilter" />
  </appender>  
  <root>
    <level value="DEBUG"/>
    <appender-ref ref="PluginFileAppender"/>
    <appender-ref ref="TemperatureFileAppender" />
  </root>
</log4net>

