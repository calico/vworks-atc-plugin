<Window x:Class="ATCVWorksPlugin.ATCDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"        
        xmlns:local="clr-namespace:ATCVWorksPlugin"
        mc:Ignorable="d"
        Title="Thermo ATC Diagnostics" Height="750" Width="1100" FontSize="14" ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="DataGridCell">
            <Style.Triggers>
                <Trigger Property="IsSelected"
                        Value="True">
                    <Setter Property="BorderBrush"
                        Value="Black" />
                    <Setter Property="BorderThickness"
                        Value="1" />
                    <Setter Property="FontStyle" Value="Italic"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TabControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.Row="0">
            <TabItem Header="Device Control" DataContext="{Binding DeviceTab}">
                <Grid Name="appMainGrid" FlowDirection="LeftToRight" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="6.8*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"></RowDefinition>
                            <RowDefinition Height="3*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Visibility="{ Binding LoadingVisibility }">
                            <fa:ImageAwesome Icon="Refresh" Spin="True" Height="50" Width="50" OpacityMask="Azure" Opacity="0.4" />
                        </Grid>
                        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition Height="1.1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="2*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15*"></ColumnDefinition>
                                    <ColumnDefinition Width="25*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0" Grid.ColumnSpan="2" FontSize="20" FontWeight="Bold" Content="Instrument Control" Margin="10"/>
                                <Label Grid.Row="1" Grid.Column="0" FontSize="14" Width="120" Content="Host Name or IP"/>
                                <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Width="Auto">
                                    <TextBox Width="120" HorizontalAlignment="Left" FontSize="14" Text="{ Binding Path=InstrumentId, Mode=TwoWay}"/>
                                    <Button x:Name="discoverBtn" Click="DiscoverBtn_Click" Margin="10,0,0,0" Content="Discover..."  Width="90"/>
                                </WrapPanel>
                                <Label Grid.Row="2" Grid.Column="0" FontSize="14" Width="120" Content="IP Address" />
                                <Label Grid.Row="2" Grid.Column="1" FontSize="14" Width="240" HorizontalAlignment="Left" Content="{ Binding InstrumentAddress }"/>
                                <Label Grid.Row="3" Grid.Column="0" FontSize="14" Width="120" Content="Status"/>
                                <Label Grid.Row="3" Grid.Column="1" FontSize="14" Width="240" HorizontalAlignment="Left" Content="{ Binding InstrumentStatus }"/>
                                <Label Grid.Row="4" Grid.Column="0" FontSize="14" Width="120" Content="Product Name"/>
                                <Label Grid.Row="4" Grid.Column="1" FontSize="14" Width="240" HorizontalAlignment="Left" Content="{ Binding InstrumentType }"/>
                                <Label Grid.Row="5" Grid.Column="0" FontSize="14" Width="120" Content="Serial Number" />
                                <Label Grid.Row="5" Grid.Column="1" FontSize="14" Width="240" HorizontalAlignment="Left" Content="{ Binding InstrumentSerial }"/>
                                <Label Grid.Row="6" Grid.Column="0" FontSize="14" Width="120" Content="Firmware Version"/>
                                <Label Grid.Row="6" Grid.Column="1" FontSize="14" Width="240" HorizontalAlignment="Left" Content="{ Binding InstrumentFirmware }" />
                                <WrapPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="10,5">
                                    <Button x:Name="connectBtn" Click="ConnectBtn_Click" Content="Connect"/>
                                    <Button x:Name="disconnectBtn" Click="DisconnectBtn_Click" Content="Disconnect"/>
                                    <Button x:Name="openLidBtn" Click="OpenLidBtn_Click" Content="Open Lid"/>
                                    <Button x:Name="closeLidBtn" Click="CloseLidBtn_Click" Content="Close Lid"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Grid.Row="1" Margin="5">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.7*"></RowDefinition>
                                    <RowDefinition Height="1*"></RowDefinition>
                                    <RowDefinition Height="3*"></RowDefinition>
                                    <RowDefinition Height="1*"></RowDefinition>
                                    <RowDefinition Height="1.6*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17*"></ColumnDefinition>
                                    <ColumnDefinition Width="25*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" FontSize="20" FontWeight="Bold" Content="Run Progress" Margin="10" VerticalAlignment="center"/>
                                <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,10,5,5" VerticalAlignment="center">
                                    <Label Content="Stage "></Label>
                                    <Label Content="{Binding RunStage}" Width="20"></Label>
                                    <Label Content="/ Cycle "></Label>
                                    <Label Content="{Binding RunCycle}" Width="30"></Label>
                                    <Label Content="/ Step "></Label>
                                    <Label Content="{Binding RunStep}" Width="20"></Label>
                                </WrapPanel>
                                <RadioButton GroupName="runTimer" Grid.Row="1" Grid.Column="0" FontSize="14" Margin="20,5" Content="Remaining Time" IsChecked="{Binding Path=ViewByRemainingTime, Mode=TwoWay}" Checked="RunTimerRadioButton_Checked"/>
                                <RadioButton GroupName="runTimer" Grid.Row="1" Grid.Column="1" FontSize="14" Margin="20,5,20,0" Content="Elapsed Time" IsChecked="{Binding Path=ViewByElapsedTime, Mode=TwoWay}" Checked="RunTimerRadioButton_Checked"/>
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Content="{Binding RunTimer}" Height="100" Width="350" Margin="10,5"
                           HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="70" />
                                <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,5,10,5">
                                    <Button x:Name="startRunBtn" Click="StartRunBtn_Click" Content="Start"/>
                                    <Button x:Name="pauseRunBtn" Click="PauseRunBtn_Click" Content="Pause"/>
                                    <Button x:Name="resumeRunBtn" Click="ResumeRunBtn_Click" Content="Resume"/>
                                    <Button x:Name="abortRunBtn" Click="AbortRunBtn_Click" Content="Abort"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Grid.Row="0" Margin="5">
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="116*"></RowDefinition>
                                <RowDefinition Height="440*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" FontSize="20" FontWeight="Bold" Content="Real Time Monitoring" Margin="10"/>
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Width="400" Margin="20,0" HorizontalAlignment="Left">
                                    <Label Width="200" FontSize="14" Content="Cover Temperature"/>
                                    <Label Width="100" FontSize="14" Content="{Binding CoverTemperature}" />
                                    <Label Width="200" FontSize="14" Content="Block Temperature"/>
                                    <Label Width="100" FontSize="14" Content="{Binding BlockTemperature}" />
                                </WrapPanel>
                            </Grid>
                            <lvc:CartesianChart Margin="10,15,10,15" Grid.Row="1" x:Name="Chart">
                                <lvc:CartesianChart.Series>
                                    <lvc:LineSeries Title="Cover Temperature" Values="{Binding CoverPlotValues}" PointGeometrySize="4" PointForeground="Blue" StrokeThickness="2" Stroke="Blue" Fill="Transparent"/>
                                    <lvc:LineSeries Title="Block Temperature" Values="{Binding BlockPlotValues}" PointGeometrySize="4" PointForeground="Red" StrokeThickness="2" Stroke="Red" Fill="Transparent"/>
                                </lvc:CartesianChart.Series>
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis LabelFormatter="{Binding DateTimeFormatter}"
                          MaxValue="{Binding XAxisMax}" 
                          MinValue="{Binding XAxisMin}"
                          DisableAnimations="True">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Step="{Binding XAxisStep}"></lvc:Separator>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis LabelFormatter="{Binding TemperatureFormatter}"
                          MaxValue="{Binding YAxisMax}" 
                          MinValue="{Binding YAxisMin}"
                          DisableAnimations="True">
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Protocol Editor" DataContext="{Binding ProtocolTab}">
                <Grid Background="#FFE5E5E5" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52*"/>
                        <ColumnDefinition Width="1033*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0*"></RowDefinition>
                        <RowDefinition Height="393*"></RowDefinition>
                        <RowDefinition Height="56*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="1" Margin="0,10,0,73" Grid.ColumnSpan="3" Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"></RowDefinition>
                            <RowDefinition Height="3.5*"></RowDefinition>
                            <RowDefinition Height="16*"></RowDefinition>
                            <RowDefinition Height="2.5*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"></ColumnDefinition>
                                    <ColumnDefinition Width="1.05*"></ColumnDefinition>
                                    <ColumnDefinition Width="1*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="10,10,20,10" VerticalAlignment="Center">
                                    <Label Content="Run Mode" Margin="0,0,10,0"></Label>
                                    <ComboBox Name="runModeBox" Width="130" ItemsSource="{ Binding ProtocolRunModes }" 
                                  SelectedItem="{ Binding ProtocolModel.ProtocolRunMode, Mode=TwoWay }" >
                                    </ComboBox>
                                </WrapPanel>
                                <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,10,20,10" VerticalAlignment="Center">
                                    <Label Content="Cover Temperature" Margin="0,0,10,0" VerticalAlignment="Center"></Label>
                                    <TextBox Width="60" Text="{Binding Path=ProtocolModel.CoverTemperature, Mode=TwoWay}"></TextBox>
                                    <Label Content="°C"></Label>
                                </WrapPanel>
                                <WrapPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="10,10,20,10" VerticalAlignment="Center">
                                    <Label Content="Sample Volume" Margin="0,0,10,0" VerticalAlignment="Center"></Label>
                                    <TextBox Width="60" Text="{Binding Path=ProtocolModel.SampleVolume, Mode=TwoWay}"></TextBox>
                                    <Label Content="µL"></Label>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="0" Margin="10,5,5,0" FontWeight="Bold" VerticalAlignment="Center">Stages</Label>
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="5,5,10,0">
                            <Label FontWeight="Bold" VerticalAlignment="Center">Steps</Label>
                            <TextBlock Margin="5,5,10,0" VerticalAlignment="Center" FontSize="12" Text="(Use -1 as &quot;Hold Time&quot; for Infinite Hold step)"/>
                        </DockPanel>
                        <DataGrid Name="ProtocolStages" AutoGenerateColumns="False" Grid.Row="2" Grid.Column="0" Margin="10,0,5,0" CanUserSortColumns="False" 
                      HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Background="Transparent"
                      ItemsSource="{ Binding Stages }" SelectionChanged="protocolStages_Selected" LoadingRow="ProtocolGrid_LoadingRow"
                      SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stage" Binding="{Binding Name}" Width="1*"/>
                                <DataGridTextColumn Header="Cycle" Binding="{Binding Cycle}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Name="ProtocolSteps" AutoGenerateColumns="False" Grid.Row="2" Grid.Column="1" Margin="5,0,10,0" CanUserSortColumns="False" 
                      HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Background="Transparent"
                      ItemsSource="{ Binding SelectedStage.Steps }" LoadingRow="ProtocolGrid_LoadingRow"
                      SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Temperature (°C)" Binding="{Binding Temperature}" Width="1*"/>
                                <DataGridTextColumn Header="Ramp Rate (%)" Binding="{Binding RampRate}" Width="1*"/>
                                <DataGridTextColumn Header="Hold Time (s)" Binding="{Binding HoldTime}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="3" Grid.Column="0" Margin="10,0,5,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Button Name="btnAddStage" Grid.Column="0" HorizontalAlignment="Stretch" Click="btnAddStage_Click">
                                <fa:ImageAwesome Icon="Plus" Height="10" Width="10" OpacityMask="Azure" Opacity="0.7" x:Name="AddStage" />
                            </Button>
                            <Button Name="btnDeleteStage" Grid.Column="1" HorizontalAlignment="Stretch" Click="btnDeleteStage_Click">
                                <fa:ImageAwesome Icon="Minus" Height="10" Width="10" OpacityMask="Azure" Opacity="0.7" x:Name="DeleteStage"/>
                            </Button>
                            <Button Name="btnMoveUpStage" Grid.Column="2" HorizontalAlignment="Stretch" Click="btnMoveUpStage_Click">
                                <fa:ImageAwesome Icon="AngleUp" Height="10" Width="10" OpacityMask="Azure" Opacity="0.8" x:Name="MoveUpStage"/>
                            </Button>
                            <Button Name="btnMoveDownStage" Grid.Column="3" HorizontalAlignment="Stretch" Click="btnMoveDownStage_Click">
                                <fa:ImageAwesome Icon="AngleDown" Height="10" Width="10" OpacityMask="Azure" Opacity="0.8" x:Name="MoveDownStage"/>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="1" Margin="5,0,10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Button Name="btnAddStep" Grid.Column="0" HorizontalAlignment="Stretch" Click="btnAddStep_Click">
                                <fa:ImageAwesome Icon="Plus" Height="10" Width="10" OpacityMask="Azure" Opacity="0.7" x:Name="AddStep"/>
                            </Button>
                            <Button Name="btnDeleteStep" Grid.Column="1" HorizontalAlignment="Stretch" Click="btnDeleteStep_Click">
                                <fa:ImageAwesome Icon="Minus" Height="10" Width="10" OpacityMask="Azure" Opacity="0.7" x:Name="DeleteStep" />
                            </Button>
                            <Button Name="btnMoveUpStep" Grid.Column="2" HorizontalAlignment="Stretch" Click="btnMoveUpStep_Click">
                                <fa:ImageAwesome Icon="AngleUp" Height="10" Width="10" OpacityMask="Azure" Opacity="0.8" x:Name="MoveUpStep"/>
                            </Button>
                            <Button Name="btnMoveDownStep" Grid.Column="3" HorizontalAlignment="Stretch" Click="btnMoveDownStep_Click">
                                <fa:ImageAwesome Icon="AngleDown" Height="10" Width="10" OpacityMask="Azure" Opacity="0.8" x:Name="MoveDownStep"/>
                            </Button>
                        </Grid>
                    </Grid>
                    <DockPanel Grid.Row="2" HorizontalAlignment="Stretch" Grid.ColumnSpan="3" Margin="0,0.5,0,1">
                        <Button Name="btnImportFile" Click="btnImportFile_Click" Width="80" Height="30" Margin="10,10,10,10" DockPanel.Dock="Left">Load...</Button>
                        <Button Name="btnExportFile" Click="btnExportFile_Click" Width="80" Height="30" Margin="0,10,10,10" DockPanel.Dock="Left">Save...</Button>
                        <Button Name="btnExportSILA" Click="btnExportSiLA_Click" Width="110" Height="30" Margin="0,10,10,10" DockPanel.Dock="Left">Export SiLA...</Button>
                        <Button Name="btnClose" Click="btnClose_Click" Width="90" Height="30" Margin="0,10,10,10" DockPanel.Dock="Right">Done</Button>
                        <WrapPanel></WrapPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>